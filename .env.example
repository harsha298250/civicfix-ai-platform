# CivicFix AI — Local Environment Variables Template
# Copy this file to .env and customize for local development.
# WARNING: Never commit .env or real production credentials to version control.

# PostgreSQL Configuration
POSTGRES_DB=civicfix_db
POSTGRES_USER=civicfix_user
POSTGRES_PASSWORD=civicfix_dev_password_only
# Note: Host port 5433 is used because host port 5432 is occupied by an existing local PostgreSQL service.
POSTGRES_PORT=5433

# Spring Boot Backend Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5433
DB_NAME=civicfix_db
DB_USERNAME=civicfix_user
DB_PASSWORD=civicfix_dev_password_only

# Security & CORS
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TIMEOUT_MINUTES=60
