# ==============================================================================
# CivicFix Platform — Environment Configuration Template
# Copy this file to .env to customize settings for docker compose or local development.
# WARNING: Never commit .env or real production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=civicfix_db
POSTGRES_USER=civicfix_user
POSTGRES_PASSWORD=civicfix_dev_password_only
# Host port mapping for local database access (5433 avoids conflict with local PostgreSQL)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
# Active Spring profile: 'dev' enables local dev seed accounts; 'prod' enforces ProductionSafetyGuard
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_PORT=8080

# Database connection settings (used for non-compose local runs; in compose, host is 'postgres')
DB_HOST=localhost
DB_PORT=5433
DB_NAME=civicfix_db
DB_USERNAME=civicfix_user
DB_PASSWORD=civicfix_dev_password_only

# Security & CORS configuration
FRONTEND_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
SESSION_TIMEOUT_MINUTES=60
ALLOW_SEED_ACCOUNTS=true

# Storage directory for uploaded repair evidence
STORAGE_UPLOAD_DIR=/app/uploads/evidence

# SLA & Scheduler Configuration
SLA_ESCALATION_ENABLED=true
AUTO_CONFIRM_ENABLED=true
AUTO_CONFIRM_DAYS=7

# Evidence Location Verification Limits (meters)
EVIDENCE_MAX_DISTANCE=100.0
EVIDENCE_MAX_ACCURACY=100.0

# Reverse Proxy Security
# Set to 'true' when running behind a trusted reverse proxy (e.g. Nginx in docker-compose).
# When true, uses the last IP from X-Forwarded-For; when false, ignores proxy headers to prevent spoofing.
TRUSTED_PROXY_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Frontend Configuration (Nginx SPA Web Server)
# ------------------------------------------------------------------------------
# Exposed host port for Nginx web server (http://localhost:80)
FRONTEND_PORT=80

# Frontend API base URL (defaults to /api so Nginx reverse proxies to backend service)
VITE_API_BASE_URL=/api

# Interactive Persona Switcher (Development / Demo Only)
# When 'true', displays the quick role switcher in the bottom right corner for capstone evaluation.
# WARNING: MUST stay 'false' in production environments.
VITE_DEMO_MODE=false
