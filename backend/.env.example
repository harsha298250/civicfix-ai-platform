# CivicFix Backend - Environment Configuration Template
# Copy this file to .env in backend/ or root, or export as environment variables.
# NEVER commit the actual .env with production credentials.

# Database configuration
# Note: Host port is 5433 when running via Docker Compose to avoid conflict with local port 5432
DB_HOST=localhost
DB_PORT=5433
DB_NAME=civicfix_db
DB_USER=civicfix_user
DB_PASSWORD=replace_with_secure_password_in_env

# Server configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security and session configuration
SESSION_COOKIE_NAME=CIVICFIX_SESSION
SESSION_COOKIE_SECURE=false
SESSION_MAX_INACTIVE_INTERVAL_SECONDS=1800
